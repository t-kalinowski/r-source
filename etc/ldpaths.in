: ${JAVA_HOME=@JAVA_HOME@}
: ${R_JAVA_LD_LIBRARY_PATH=@R_JAVA_LD_LIBRARY_PATH@}
if test -n "@R_LD_LIBRARY_PATH@"; then
: ${R_LD_LIBRARY_PATH=${R_HOME}/lib@R_ARCH@:@R_LD_LIBRARY_PATH@}
else
: ${R_LD_LIBRARY_PATH=${R_HOME}/lib@R_ARCH@}
fi
if test -n "${R_JAVA_LD_LIBRARY_PATH}"; then
  R_LD_LIBRARY_PATH="${R_LD_LIBRARY_PATH}:${R_JAVA_LD_LIBRARY_PATH}"
fi
## This is DYLD_FALLBACK_LIBRARY_PATH on Darwin (macOS) and
## LD_LIBRARY_PATH elsewhere.
## However, on macOS >=10.11 (if SIP is enabled, the default), the
## environment value will not be passed to a script such as R.sh, so
## would not seen here.
if test -z "${@Rshlibpath_var@}"; then
  @Rshlibpath_var@="${R_LD_LIBRARY_PATH}"
else
  @Rshlibpath_var@="${R_LD_LIBRARY_PATH}:${@Rshlibpath_var@}"
fi
export @Rshlibpath_var@

## On macOS, prebuilt packages often encode framework absolute install-names
## for libR/libRblas/libRlapack. Prefer this build's lib directory first so
## those references resolve to the in-tree dylibs and we do not load a second
## libR image into the process.
if test "@Rshlibpath_var@" = "DYLD_FALLBACK_LIBRARY_PATH"; then
  if test -z "${DYLD_LIBRARY_PATH}"; then
    DYLD_LIBRARY_PATH="${R_LD_LIBRARY_PATH}"
  else
    DYLD_LIBRARY_PATH="${R_LD_LIBRARY_PATH}:${DYLD_LIBRARY_PATH}"
  fi
  export DYLD_LIBRARY_PATH
fi
